# ==============================================================
# MadanCo Production Environment Configuration Template
# شرکت محاسبات عملیات داده ارزیابی نوین با مسئولیت محدود
# ==============================================================

# Application Environment & Port
NODE_ENV=production
# In cPanel "Setup Node.js App", PORT is injected dynamically by Phusion Passenger.
# If running standalone, defaults to 5000.
PORT=5000

# Security & Authentication (Required: Generate a 64+ char random hex string)
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_256bit
JWT_EXPIRES_IN=7d

# Database & Media Storage
# For cPanel deployment, it is strongly recommended to place data in a persistent directory:
# e.g., DATABASE_PATH=/home/username/madan-data/madanco.sqlite
DATABASE_PATH=./server/data/madanco.sqlite
UPLOADS_DIR=./server/data/uploads
DIST_DIR=./dist

# Domains & CORS (Comma-separated allowed origins)
CORS_ORIGIN=https://madan.co.ir,https://www.madan.co.ir,https://madan.ba3tani.ir
SITE_URL=https://madan.co.ir
PLATFORM_LIVE_URL=https://madan.ba3tani.ir

# Initial Administrator Credentials (Only used on very first boot if database is completely fresh)
# You can also set/change password anytime via CLI: npm run admin:reset-password <username> <new_password>
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_to_a_strong_password_before_first_run
INITIAL_ADMIN_EMAIL=info@madan.co.ir

# SMTP Email Notifications (Optional: used for forwarding contact form submissions)
SMTP_HOST=smtp.madan.co.ir
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@madan.co.ir
SMTP_PASS=
NOTIFICATION_RECEIVER_EMAIL=info@madan.co.ir
