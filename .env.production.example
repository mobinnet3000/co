# ==============================================================================
# MadanCo Production Environment Configuration Template (.env)
# شرکت محاسبات عملیات داده ارزیابی نوین با مسئولیت محدود
# Domain Target: https://madan.co.ir
# ==============================================================================

# 1. Server Environment
NODE_ENV=production
# In cPanel Phusion Passenger, PORT is injected dynamically by the web server.
# If running standalone, set desired port.
PORT=5000

# 2. Base Domain URL
SITE_URL=https://madan.co.ir
BASE_URL=https://madan.co.ir
PLATFORM_LIVE_URL=https://madan.co.ir

# 3. Security & JWT Token Signing
# CRITICAL: Generate a strong 64-char random string via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_random_hex_string_for_production
JWT_EXPIRES_IN=7d

# 4. Persistent Storage (Zero Data Loss Architecture)
# Option A (Recommended): Store outside project code to survive code updates
DATABASE_PATH=/home/username/madan_data/database/madanco.sqlite
UPLOADS_DIR=/home/username/madan_data/uploads
BACKUP_DIR=/home/username/madan_data/backups

# Option B (Default relative path inside project):
# DATABASE_PATH=server/data/madanco.sqlite
# UPLOADS_DIR=server/uploads
# BACKUP_DIR=server/backups

# 5. Initial Super Administrator Account
# Only seeded on fresh initial boot if user does not exist. After deployment, change password anytime via:
# npm run admin:reset-password -- admin "YourNewStrongPassword"
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=info@madan.co.ir
INITIAL_ADMIN_PASSWORD=

# 6. CORS Whitelist
CORS_ORIGIN=https://madan.co.ir,https://www.madan.co.ir
